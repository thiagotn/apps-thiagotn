---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada — apps.thiagotn" description="Essa página não existe.">
  <main
    style="max-width:1200px;margin:0 auto;padding:96px clamp(20px,5vw,64px);display:flex;flex-direction:column;gap:20px;align-items:flex-start"
  >
    <h1 style="margin:0;font-size:clamp(40px,6vw,76px);line-height:1.06;margin-left:-0.028em">
      <span style="display:block">Essa página</span>
      <span style="display:block;color:var(--color-accent)">não existe.</span>
    </h1>
    <p style="margin:0;font-size:18px;line-height:1.6;max-width:48ch;color:color-mix(in srgb,var(--color-text) 80%,transparent)">
      Talvez o link esteja velho. A lista completa de apps está na página inicial.
    </p>
    <a class="btn btn-primary" href="/" style="font-size:15px;padding:10px 20px">Ver os apps</a>
  </main>
</Base>
