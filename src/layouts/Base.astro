---
import { LOCALES, PATHS, UI, DEFAULT_LOCALE, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Caminho desta página no idioma atual. Default: a home do idioma. */
  path?: string;
  title?: string;
  description?: string;
}
const { locale, path, title, description } = Astro.props;
const t = UI[locale];
const here = path ?? PATHS[locale];
const abs = (p: string) => new URL(p, Astro.site).href;
const ogImage = abs('/og.png');
---

<!doctype html>
<html lang={locale} data-filter="__all__">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ?? t.title}</title>
    <meta name="description" content={description ?? t.description} />
    <link rel="canonical" href={abs(here)} />

    <!-- Mesmo esquema do thiagotn.com: um alternate por idioma e o x-default no padrão,
         que é quem o buscador serve para quem não casa com nenhum dos dois. -->
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={abs(PATHS[l])} />)}
    <link rel="alternate" hreflang="x-default" href={abs(PATHS[DEFAULT_LOCALE])} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="apps.thiagotn" />
    <meta property="og:title" content={title ?? t.title} />
    <meta property="og:description" content={description ?? t.description} />
    <meta property="og:url" content={abs(here)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    {
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={l.replace('-', '_')} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f5ead8" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Fontes do design system: Caprasimo nos títulos, Figtree no texto.
         Por <link> e não pelo @import do CSS, que serializaria o download. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caprasimo&family=Figtree:wght@400;600;700&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/organic.css';

  /* Ajustes que no protótipo viviam no <helmet> da página. Cada um é load-bearing:
     - overflow-x: clip        → o círculo decorativo fica em right:-160px; sem isto ele
                                 cria barra de rolagem horizontal;
     - text-wrap: pretty       → quebra de linha dos parágrafos e títulos;
     - cor de link accent-700  → mais escura que o --color-accent do design system, para
                                 o link "Blog" ter contraste sobre o fundo bege. */
  /* O clip vai nos DOIS: com o <html> em `visible`, o overflow do body propaga para a
     viewport e o body deixa de clipar coisa nenhuma — o círculo decorativo voltava a
     empurrar 160px de rolagem horizontal no telefone. */
  html,
  body {
    overflow-x: clip;
  }
  body {
    text-wrap: pretty;
  }
  a {
    color: var(--color-accent-700);
  }
  a:hover {
    color: var(--color-accent-800);
  }

  /* No telefone a barra do topo não cabe numa linha só: "github.com/thiagotn" sozinho
     passa da largura da tela. Deixar quebrar é melhor que rolagem lateral. */
  @media (max-width: 480px) {
    .nav {
      flex-wrap: wrap;
      row-gap: 10px;
    }
  }
</style>
