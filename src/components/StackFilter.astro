---
import { ALL, type Chip } from '../lib/apps';
import { UI, type Locale } from '../i18n/ui';

interface Props {
  chips: Chip[];
  locale: Locale;
}
const { chips, locale } = Astro.props;
const t = UI[locale];
---

<section aria-label={t.filterRegion} style="display:flex;flex-direction:column;gap:12px;padding:0 0 32px">
  <span
    style="font-size:13px;letter-spacing:0.06em;text-transform:uppercase;font-weight:600;color:var(--color-accent-700)"
    >{t.filterLabel}</span
  >
  <div style="display:flex;flex-wrap:wrap;gap:8px">
    {
      chips.map((chip) => (
        // Todos os chips nascem com .tag-outline; o CSS do filtro pinta de accent
        // aquele cujo data-stack casa com o data-filter do <html>. Assim o estado
        // inicial já está certo no HTML, sem esperar o JS.
        <button
          type="button"
          class="tag tag-outline js-chip"
          data-stack={chip.name}
          aria-pressed={chip.name === ALL ? 'true' : 'false'}
          style="display:inline-flex;align-items:center;gap:6px;font-size:14px;padding:7px 14px;cursor:pointer;font-family:inherit"
        >
          {chip.isAll ? t.filterAll : chip.name}
          <span style="font-size:12px;opacity:0.7">{chip.count}</span>
        </button>
      ))
    }
  </div>
</section>
