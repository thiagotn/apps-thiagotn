---
import Icon from './Icon.astro';
import { stacksAttr, thumbUrl, type App } from '../lib/apps';

interface Props {
  app: App & { tint: string };
}
const { app } = Astro.props;
---

<!-- data-stacks e data-featured são lidos pelo CSS do filtro (gerado em index.astro).
     O card do app em destaque existe aqui também: sob "Todos" ele fica escondido, porque
     aparece no bloco de cima; sob qualquer outro filtro ele volta ao grid. -->
<article
  class="card js-app"
  data-stacks={stacksAttr(app.stacks)}
  data-featured={app.featured ? 'true' : undefined}
  style="padding:14px;gap:0;box-shadow:var(--shadow-sm)"
>
  <div
    style={`position:relative;aspect-ratio:16/10;border-radius:var(--radius-lg);overflow:hidden;background:${app.tint}`}
  >
    <!-- O .washed vai no wrapper, não na <img>: assim o filtro também lava o fundo
         colorido que aparece enquanto (ou se) a imagem não carregar. -->
    <div class="washed" style="position:absolute;inset:0">
      <img
        src={thumbUrl(app.slug, '16x10')}
        alt={`Captura de tela de ${app.name}`}
        width="1120"
        height="700"
        loading="lazy"
        decoding="async"
        style="width:100%;height:100%;object-fit:cover"
      />
    </div>
  </div>

  <div style="display:flex;flex-direction:column;gap:12px;padding:18px 8px 6px;flex:1">
    <span
      style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;font-weight:600;color:var(--color-accent-700)"
      >{app.kind}</span
    >
    <h3 style="margin:0;font-size:24px;line-height:1.15">{app.name}</h3>
    <!-- flex:1 no parágrafo (e no wrapper) é o que alinha a linha de botões entre cards
         de resumos com alturas diferentes. -->
    <p
      style="margin:0;font-size:15px;line-height:1.55;color:color-mix(in srgb,var(--color-text) 78%,transparent);flex:1"
    >
      {app.summary}
    </p>

    <div style="display:flex;flex-wrap:wrap;gap:6px">
      {
        app.stacks.map((stack) => (
          <span class="tag tag-neutral js-tag" data-stack={stack}>
            {stack}
          </span>
        ))
      }
    </div>

    <div style="display:flex;gap:8px;align-items:center;padding-top:8px">
      <a
        class="btn btn-primary"
        href={app.url}
        target="_blank"
        rel="noopener"
        style="flex:1;font-size:14px;padding:9px 16px"
      >
        Abrir app
        <Icon name="arrow-up-right" size={15} />
      </a>
      <a
        class="btn btn-secondary btn-icon"
        href={app.repo}
        target="_blank"
        rel="noopener"
        aria-label={`Código de ${app.name} no GitHub`}
        title="Ver no GitHub"
        style="width:40px;height:40px"
      >
        <Icon name="github" size={17} />
      </a>
    </div>
  </div>
</article>
